{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/shelf-check", "destination": "/book/", "permanent": true },
    { "source": "/shelf-check/:path*", "destination": "/book/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'unsafe-inline' https://unpkg.com; worker-src 'self' blob:" }
      ]
    },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/selected/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/selected/packaging/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
